---
import LeadForm from './LeadForm.astro';
import { siteConfig as c } from '../data/siteConfig';
const { eyebrow, title, lead, chips = [], location = 'Homepage', id = 'hero' } = Astro.props;
const ph = (s: string) => s.replaceAll('{{phone}}', c.phoneDisplay);
---
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{ph(lead)}</p>
      {chips.length > 0 && <ul class="chips">{chips.map((t: string) => <li>{t}</li>)}</ul>}
      <a class="hero-phone" href={'tel:' + c.phoneHref}><span class="ico"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg></span>{c.phoneDisplay}</a>
    </div>
    <LeadForm location={location} id={id} />
  </div>
</section>
<div class="marquee" aria-hidden="true"><div class="track">
  {[0, 1].map(() => ['4000 PSI High-Pressure Scouring', 'Residential Cleanouts', 'Commercial Grease Lines', 'Sewer Camera Inspection', 'Root Intrusion Clearance', 'Medina, Ohio'].map((t) => <span>{t}</span>))}
</div></div>
