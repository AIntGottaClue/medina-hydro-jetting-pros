---
import { images } from '../data/content';
const { k, eager = false, cap = '', cls = '' } = Astro.props;
const i = (images as any)[k];
const base = import.meta.env.BASE_URL;
---
<figure class={'photo ' + cls}>
  <img src={base + 'img/' + i.f + '.webp'} alt={i.alt} width="1200" height="800" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  {cap && <figcaption>{cap}</figcaption>}
</figure>
