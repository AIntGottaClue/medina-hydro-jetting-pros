---
import Hero from './Hero.astro';
import Cta from './Cta.astro';
import { hoods } from '../data/content';
import { hoodHtml } from '../lib/hoodText';
const { a } = Astro.props;
const base = import.meta.env.BASE_URL;
const h = (t: string) => hoodHtml(t, (s: string) => `${base}services/${s}/`);
const others = hoods.filter((x: any) => x.slug !== a.slug);
---
<Hero eyebrow={`Neighborhood · Medina, Ohio`} title={`Hydro Jetting in ${a.name}, Medina OH`} lead={a.hero} chips={['Camera Verified', 'Up to 4000 PSI']} location={`${a.name}, Medina, OH`} />
<section><div class="wrap">
  <p class="crumbs"><a href={base + 'service-areas/'}>Neighborhoods</a> / {a.name}</p>
  <div class="head"><h2>{a.bodyH2}</h2></div>
  <div class="hood-prose">{a.bodyPs.map((p: string) => <p set:html={h(p)} />)}</div>
  <h3 style="margin-top:28px">What Local Property Owners Often Consider</h3>
  <ul class="hood-list">{a.considerations.map((c: string) => <li>{c}</li>)}</ul>
</div></section>
<section class="alt"><div class="wrap">
  <div class="head"><h2>{a.svcH2}</h2><p>{a.svcLead}</p></div>
  <div class="hood-prose">{Object.values(a.svc).map((p: any) => <p set:html={h(p)} />)}</div>
</div></section>
<section><div class="wrap">
  <div class="head"><h2>{a.appsH2}</h2></div>
  <div class="grid g3">{a.apps.map((x: any) => <div class="card"><h3>{x.h}</h3><p set:html={h(x.p)} /></div>)}</div>
</div></section>
<section class="alt"><div class="wrap">
  <div class="head"><h2>{a.implH2}</h2></div>
  <div class="hood-prose">{a.implPs.map((p: string) => <p>{p}</p>)}</div>
  <div class="grid g3" style="margin-top:26px">{a.impl.map((x: any) => <div class="card"><h3>{x.h}</h3><p set:html={h(x.p)} /><ul class="hood-list">{x.b.map((b: string) => <li>{b}</li>)}</ul></div>)}</div>
</div></section>
<section><div class="wrap">
  <div class="head"><h2>{a.planH2}</h2><p>{a.planPs[0]}</p></div>
  <div class="grid g4">{a.steps.map((s: any, i: number) => <div class="card"><span class="eyebrow">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></div>)}</div>
</div></section>
<section class="alt"><div class="wrap">
  <div class="head"><h2>{a.mapH2}</h2><p>{a.mapIntro}</p></div>
  <div style="border-radius:16px;overflow:hidden;border:1px solid var(--line)"><iframe src={a.map.src} width="100%" height="420" style="border:0;display:block" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={a.map.label}></iframe></div>
</div></section>
<section><div class="wrap">
  <div class="head"><h2>{a.nearbyH2}</h2><p>{a.nearbyP}</p></div>
  <ul class="towns">{others.map((n: any) => <li><a href={base + 'service-areas/' + n.slug + '/'}>{n.name}</a></li>)}</ul>
</div></section>
<section class="alt"><div class="wrap">
  <div class="head"><h2>{`Hydro jetting questions in ${a.name}`}</h2></div>
  <div class="faq">{a.faqs.map((f: any, i: number) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
</div></section>
<section><div class="wrap">
  <div class="head"><h2>{a.ctaH2}</h2></div>
  <div class="hood-prose">{a.ctaPs.map((p: string) => <p>{p}</p>)}</div>
</div></section>
<Cta />
<style is:global>
.hood-prose p{max-width:820px;margin:0 0 16px}.hood-prose a,.hood .card a{color:var(--acc);text-decoration:underline}
.hood-list{max-width:820px;padding-left:22px;margin:12px 0 0}.hood-list li{margin:6px 0}
.card a{color:var(--acc);text-decoration:underline}
</style>
