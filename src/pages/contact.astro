---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cta from '../components/Cta.astro';
import Img from '../components/Img.astro';
import { areas } from '../data/content';
import { siteConfig as c } from '../data/siteConfig';
const base = import.meta.env.BASE_URL;
---
<Base title="Contact Medina Hydro Jetting Pros | Medina, Ohio" description={`Call ${c.phoneDisplay} or send the request form for hydro jetting service in Medina, Ohio.`} path="contact/">
  <Hero eyebrow="Direct Dispatch Line" title="Contact Medina Hydro Jetting Pros" lead="Tell us what is happening, whether slow drains, recurring backups, or gurgling lines, and we will take it from there. Call or send the form." chips={['Phone', 'Online Form']} location="Contact" />
  <section><div class="wrap split">
    <div><p class="eyebrow">Where we work</p><h2>Medina, Ohio neighborhoods.</h2>
      <p>Medina, from the Public Square Historic District to Medfair Heights.</p>
      <ul class="towns">{areas.map((a) => <li><a href={base + 'service-areas/' + a.slug + '/'}>{a.name}</a></li>)}</ul>
      <p style="margin-top:22px">The fastest way to reach us is by phone: <a href={'tel:' + c.phoneHref} style="color:var(--acc);font-family:'IBM Plex Mono';font-weight:700">{c.phoneDisplay}</a></p></div>
    <Img k="jet" eager cap="High-pressure jetting" />
  </div></section>
  <section class="alt"><div class="wrap">
    <div class="head"><p class="eyebrow">What happens next</p><h2>Three steps after you reach out.</h2></div>
    <div class="grid g3">
      <div class="card"><div class="step">01</div><h3>We review your line</h3><p>We read what your line is doing and ask any follow-up questions.</p></div>
      <div class="card"><div class="step">02</div><h3>We talk through access</h3><p>We go over cleanout access and the camera inspection.</p></div>
      <div class="card"><div class="step">03</div><h3>The visit is scheduled</h3><p>The jetting visit is set for a time that works.</p></div>
    </div>
  </div></section>
  <Cta />
</Base>
